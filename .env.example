# Supabase
# Found in your Supabase dashboard under Project Settings > API.
# Copy this file to .env.local and fill in the values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site origin used for auth email redirects.
# Local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: set this to the HTTPS Vercel production URL, for example:
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# OpenAI — server-only. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional. Milliseconds the OpenAI SDK waits for a single request. Default: 120000.
OPENAI_REQUEST_TIMEOUT_MS=120000
